# redan.toml -- generated by `redan init`
# See: https://github.com/getredan/redan

image = "{{ image }}"
{%- if claude %}
# Remove --dangerously-skip-permissions to re-enable Claude's
# built-in permission prompts inside the VM.
{%- endif %}
command = "{{ command }}"
{%- if interactive is defined and interactive %}
interactive = true
{%- endif %}
{%- if timeout is defined and timeout %}
timeout = {{ timeout }}
{%- endif %}

[network]
{%- if claude %}
# Hosts Claude Code needs to function. Add project-specific
# API hosts here. Remove any you don't need.
{%- else %}
# Allowed outbound hosts. Empty = deny all, ["*"] = allow all.
{%- endif %}
allow = [
{%- for host in allow_hosts %}
    "{{ host }}",
{%- endfor %}
]
{%- if forwards %}
# TCP port forwards (guest -> host localhost).
# Format: "PORT" or "GUEST_PORT:HOST_PORT"
forward = [
{%- for fwd in forwards %}
    "{{ fwd }}",
{%- endfor %}
]
{%- endif %}
{%- for tag, mount in mounts %}

[mount.{{ tag }}]
source = "{{ mount.source }}"
{%- if mount.target %}
target = "{{ mount.target }}"
{%- endif %}
{%- endfor %}

# Git and SSH identity (not mounted by default).
# These are writable by the guest because virtio-fs via libkrun
# doesn't support read-only mounts. Only uncomment if you trust
# the commands running inside the VM.
#
# [mount.gitconfig]
# source = "~/.gitconfig"
# target = "/home/dev/.gitconfig"
#
# [mount.ssh]
# source = "~/.ssh"
# target = "/home/dev/.ssh"
{%- if env %}

[env]
{%- if claude %}
# CLAUDE_CONFIG_DIR in the workspace mount persists sessions
# across redan restarts (conversation history, preferences).
{%- endif %}
{%- for key, value in env %}
{{ key }} = "{{ value }}"
{%- endfor %}
{%- endif %}
